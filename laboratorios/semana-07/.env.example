# Copiar a .env y completar. NUNCA subir .env al repo.
# Identificador de cuenta: <org>-<account> (Snowsight > Admin > Accounts > Account identifier)
SNOWFLAKE_ACCOUNT=myorg-myaccount
SNOWFLAKE_USER=NYC_TAXI_SVC
SNOWFLAKE_ROLE=NYC_TAXI_ROLE
SNOWFLAKE_WAREHOUSE=NYC_TAXI_WH
SNOWFLAKE_DATABASE=NYC_TAXI
# Archivo PEM completo de la llave privada PKCS8 (sin passphrase) codificado en base64, una sola línea:
#   base64 -i rsa_key.p8 | tr -d '\n'
# Se genera con: ./scripts/generate_keys.sh
SNOWFLAKE_PRIVATE_KEY=

# Credenciales de la UI/API de Kestra (Kestra 1.x exige basic auth).
# Password: mínimo 8 caracteres, una mayúscula y un número.
KESTRA_USER=admin@kestra.io
KESTRA_PASSWORD=Admin1234
